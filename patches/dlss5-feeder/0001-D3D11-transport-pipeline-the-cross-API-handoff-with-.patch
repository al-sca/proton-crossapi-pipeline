From 0c5866abbb894b3257a4af8dd669c0910512a129 Mon Sep 17 00:00:00 2001
From: al-sca <208400092+al-sca@users.noreply.github.com>
Date: Sat, 17 Oct 2026 11:35:44 +0200
Subject: [PATCH] D3D11 transport: pipeline the cross-API handoff with
 async_home

The D3D11 path ran the whole hop inside one frame: copy-in, Signal, D3D12
evaluate, then a D3D11 Wait on the result before the blit. The game's queue
idled through every evaluate, and under Proton (DXVK + vkd3d-proton, two
separate VkDevices) both cross-device waits sat on the frame's critical path.

With async_home != 0 (and sync_home == 0) the D3D11 transport now does what
async_home already does on the Vulkan transport: the blit carries frame n-1's
output home, and the D3D11 queue waits on that evaluate only right before it
overwrites the shared inputs. Order on the D3D11 queue per frame:

  Wait(v_out n-1) -> copy-in n -> blit output n-1 -> Signal(v_in n)

The blit precedes the Signal, so one set of shared textures stays safe, and
the wait keeps the shared fence monotonic (the next D3D11 Signal can never
overtake the D3D12 Signal it follows). An evaluate that NGX failed is still
owed its wait. ReleaseFrameResources clears the pending value after the
drain, so a rebuilt session never waits on a stale fence value. Costs one
frame of latency. async_home=0 keeps the original path untouched.

Measured on Watch Dogs (DX11), Proton Experimental, RTX 5070 Ti, 2560x1440,
DLSS 5 NR on, same spot: 48-50 fps / 61% GPU -> 71-72 fps / 98% GPU,
frame-time p50 22.5 ms -> 14 ms. No visual artifacts observed.
---
 src/dlss5-feed.cpp | 77 ++++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 71 insertions(+), 6 deletions(-)

diff --git a/src/dlss5-feed.cpp b/src/dlss5-feed.cpp
index 7045857..050e41c 100644
--- a/src/dlss5-feed.cpp
+++ b/src/dlss5-feed.cpp
@@ -987,6 +987,11 @@ struct Cfg
                            // copies, so the whole frame is ONE queue submit -- the shape a
                            // normal game has, and the one structural difference left between
                            // us and a game an in-driver frame pacer is happy with.
+                           // D3D11 transport: any non-zero value pipelines the frame the same
+                           // way -- the blit carries frame n-1's output home and the D3D11
+                           // queue waits on that evaluate only before it overwrites the shared
+                           // inputs, so the game renders frame n+1 while D3D12 runs frame n
+                           // instead of idling through the evaluate. Ignored with sync_home.
     int   sync_home;       // Vulkan: flush and CPU-wait for copy home. D3D11: CPU-wait for
                            // the D3D12 result instead of enqueueing a cross-API D3D11 fence wait.
     int   passthrough;     // diagnostic: mode-2 with the NGX evaluate swapped for a plain
@@ -1462,6 +1467,13 @@ struct Feed
     ID3D11Multithread         *mt;          // immediate-context serialization, restored on teardown
     bool                       mt_was_on;   // what the game had set before we turned it on
     UINT64                     fence_value;
+    // async_home on the D3D11 transport: the last evaluate submitted but not yet waited on by
+    // the D3D11 queue (0 = none), and whether its output is worth carrying home. The wait is
+    // owed even when the output is not: the next D3D11 Signal on the shared fence must not
+    // overtake the D3D12 Signal of this value, and the shared inputs must not be overwritten
+    // while the evaluate still reads them.
+    UINT64                     out11_pending;
+    bool                       out11_carry;
     ID3D11Device              *dev11;      // not owned
     bool                       dev12_owned; // true on the D3D11/Vulkan paths (we created the private device)
     reshade::api::command_queue *rs_queue;  // D3D12/Vulkan paths: ReShade's wrapper of the game's queue (not owned)
@@ -3441,6 +3453,10 @@ static void ReleaseFrameResources()
     // commands referencing these imports (including on the immediate list).
     if (g.vk.ok && g.rs_queue && (g.vk_img[SLOT_COLOR] || g_vk_probe.dev)) g.rs_queue->wait_idle();
     DrainGpu();
+    // Drained: every evaluate has signalled, and a session rebuild starts a fresh fence that
+    // a stale value would make the D3D11 queue wait on forever.
+    g.out11_pending = 0;
+    g.out11_carry   = false;
     FeedVkProbeRelease();
     // Vulkan transport: drop our raw VkImage imports (the memory is the D3D12 resource's;
     // freeing the import does not free the D3D12 resource, which SafeRelease(tex12) does).
@@ -8077,8 +8093,31 @@ static void FeedFrame11(reshade::api::effect_runtime *rt, reshade::api::command_
             if (g.need_reset || g_cfg.reset_every) g.jitter_index = 0;
             HaltonJitter(g.jitter_index, g.jitter_phases, &g.jitter_x, &g.jitter_y);
         }
-        Breadcrumb("preparing work-resolution inputs");
-        ok = CopyOrResampleInputs(ctx, color, mv, depth, mask,
+
+        // async_home: the previous frame's evaluate may still be reading the shared inputs,
+        // and its Signal on the shared fence must land before ours below. A GPU-side wait,
+        // enqueued after the game's frame -- by now the evaluate has normally retired.
+        const bool async11 = g_cfg.async_home != 0 && g_cfg.sync_home == 0 && g_cfg.mode >= 2;
+        if (g.out11_pending != 0)
+        {
+            Breadcrumb("enqueueing the D3D11 wait for the previous D3D12 result");
+            DWORD wait_exception = 0;
+            const HRESULT wait_hr = SafeD3D11FenceWait(g.ctx4, g.fence11, g.out11_pending, &wait_exception);
+            if ((wait_exception != 0 || FAILED(wait_hr)) && !WaitForD3D12ResultCpu(g.out11_pending))
+            {
+                Log("[feed] async_home: could not wait for the previous D3D12 result (%s 0x%08X)",
+                    wait_exception != 0 ? "exception" : "hr",
+                    wait_exception != 0 ? wait_exception : wait_hr);
+                FeedFail("D3D12 result wait");
+                g.frame_ready = false;   // the rebuild drains the queue
+                g.out11_carry = false;
+                ok = false;
+            }
+            g.out11_pending = 0;
+        }
+
+        if (ok) Breadcrumb("preparing work-resolution inputs");
+        if (ok) ok = CopyOrResampleInputs(ctx, color, mv, depth, mask,
                                   nullptr,
                                   reinterpret_cast<ID3D11ShaderResourceView *>(mv_srv.handle),
                                   reinterpret_cast<ID3D11ShaderResourceView *>(d_srv.handle),
@@ -8094,6 +8133,15 @@ static void FeedFrame11(reshade::api::effect_runtime *rt, reshade::api::command_
         }
         else if (ok)
         {
+            // async_home: frame n-1's output goes home now, after this frame's inputs were
+            // read from the backbuffer and before the Signal hands the Output back to D3D12.
+            if (async11 && g.out11_carry)
+            {
+                Breadcrumb("blitting the previous D3D12 output into the D3D11 backbuffer");
+                BlitOutputToBackbuffer(ctx, rtv11);
+            }
+            g.out11_carry = false;
+
             const UINT64 v_in = ++g.fence_value;
             g.ctx4->Signal(g.fence11, v_in);
             ctx->Flush();
@@ -8189,6 +8237,7 @@ static void FeedFrame11(reshade::api::effect_runtime *rt, reshade::api::command_
                 }
                 else if (NVSDK_NGX_FAILED(re))
                 {
+                    if (async11) g.out11_pending = v_out;   // submitted all the same: still owed a wait
                     Log("[feed] evaluate failed 0x%08X (%s)", re, NgxResultName(re));
                     FeedFail("evaluate");
                     g.frame_ready = false;  // rebuild rather than repeat the same failure
@@ -8197,7 +8246,20 @@ static void FeedFrame11(reshade::api::effect_runtime *rt, reshade::api::command_
                 else
                 {
                     bool result_ready = true;
-                    if (g_cfg.sync_home != 0)
+                    if (async11)
+                    {
+                        // Nothing waits here: the next frame waits before its copy-in and
+                        // carries this output home.
+                        static bool said_async = false;
+                        if (!said_async)
+                        {
+                            Log("[feed] async_home (D3D11): the blit carries frame n-1, the evaluate overlaps the next game frame");
+                            said_async = true;
+                        }
+                        g.out11_pending = v_out;
+                        g.out11_carry   = true;
+                    }
+                    else if (g_cfg.sync_home != 0)
                     {
                         static bool said_cpu_wait = false;
                         if (!said_cpu_wait)
@@ -8237,9 +8299,12 @@ static void FeedFrame11(reshade::api::effect_runtime *rt, reshade::api::command_
                                 static_cast<unsigned long long>(g.fence12->GetCompletedValue()),
                                 g.frame_slot, FormatName(g.output_fmt), g.out_scratch != nullptr,
                                 g_cfg.sync_home != 0);
-                        Breadcrumb("blitting the D3D12 output into the D3D11 backbuffer");
-                        BlitOutputToBackbuffer(ctx, rtv11);
-                        Breadcrumb("D3D11 output blit complete");
+                        if (!async11)
+                        {
+                            Breadcrumb("blitting the D3D12 output into the D3D11 backbuffer");
+                            BlitOutputToBackbuffer(ctx, rtv11);
+                            Breadcrumb("D3D11 output blit complete");
+                        }
                         const UINT64 n = ++g.frames_done;
                         g.consecutive_fails = 0;
                         if (g.sr_active) ++g.jitter_index;
-- 
2.55.0

